{
  "name": "design-library-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "docs": "npm run docs:generate && npm run docs:elements && vite --config apps/docs/vite.config.ts",
    "docs:generate": "node scripts/generate-doc-pages.mjs",
    "docs:check-lines": "node scripts/check-doc-file-length.mjs",
    "docs:elements": "ng build docs-elements && node scripts/copy-doc-elements.mjs",
    "docs:build": "npm run docs:generate && npm run docs:check-lines && npm run docs:elements && vite build --config apps/docs/vite.config.ts",
    "docs:preview": "vite preview --config apps/docs/vite.config.ts",
    "start": "node scripts/start-storybook.mjs",
    "storybook": "node scripts/start-storybook.mjs",
    "build": "ng build design-library",
    "build-storybook": "ng run design-library:build-storybook",
    "typecheck": "tsc --noEmit -p .storybook/tsconfig.json",
    "test": "playwright test",
    "pack:library": "npm run build && npm pack ./dist/design-library --pack-destination ./dist",
    "check": "npm run skills:check && npm run skills:test && npm run storybook:test-editor && npm run typecheck && npm run build && npm run build-storybook && npm run skills:verify-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stories:generate": "node scripts/generate-config-stories.mjs && node scripts/generate-llm-guidance.mjs",
    "stories:check": "node scripts/generate-config-stories.mjs --check",
    "skills:generate": "npm run stories:generate",
    "skills:check": "npm run stories:check && node scripts/generate-llm-guidance.mjs --check",
    "skills:watch": "node scripts/watch-llm-guidance.mjs",
    "skills:test": "node --test scripts/llm-guidance.test.mjs",
    "skills:verify-storybook": "node scripts/generate-llm-guidance.mjs --check --storybook-index=storybook-static/index.json",
    "storybook:test-editor": "node --test scripts/storybook-editor.test.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:http": "node mcp/http-server.mjs",
    "mcp:test": "node --test mcp/*.test.mjs"
  },
  "dependencies": {
    "@angular/animations": "22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/elements": "^22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-browser-dynamic": "22.1.5",
    "@lucide/icons": "^1.41.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "imask": "^7.6.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.5.4",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/angular": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "http-server": "^14.1.1",
    "ng-packagr": "22.1.1",
    "prettier": "^3.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
